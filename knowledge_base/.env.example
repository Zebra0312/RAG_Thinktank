# ==========================================================
# 掌柜智库 · RAG Thinktank 环境变量模板
# 使用方法：复制本文件为 .env，再按注释填写
# 注意：.env 含密钥，禁止提交到 Git；本模板可提交
# ==========================================================

# ---------------- MinerU / PDF 解析相关 ----------------
# PDF 转 Markdown 时使用的模型来源（modelscope 为魔搭）
MINERU_MODEL_SOURCE=modelscope
# 是否离线加载模型：1=离线（需已有缓存），0=在线下载
MODELSCOPE_OFFLINE=1
# 魔搭模型缓存目录（换成你自己的路径）
MODELSCOPE_CACHE=D:/ai_models/modelscope_cache
# HuggingFace 缓存目录（若用到 HF 模型）
HF_HOME=D:/ai_models/huggingface_cache
# MinerU 临时工作目录（相对项目根）
MD_ROOT_DIR=./temp-files/

# ---------------- 大模型 LLM（阿里云百炼 DashScope） ----------------
# 文本模型：用于商品名称识别等
# API Key 申请：百炼控制台 → API-KEY 管理
OPENAI_API_KEY=sk-你的百炼APIKey
# 兼容 OpenAI 的接口地址（百炼固定地址）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 默认文本模型（qwen-flash / qwen-plus 等）
LLM_DEFAULT_MODEL=qwen-flash
# 视觉模型：node_md_img 图片摘要使用
VL_MODEL=qwen3-vl-flash
# 采样温度：越低越稳定，知识库场景建议 0.1 左右
LLM_DEFAULT_TEMPERATURE=0.1

# ---------------- Embedding 向量模型（BGE-M3） ----------------
# 本地模型路径；留空则自动使用 BAAI/bge-m3 在线/缓存下载
BGE_M3_PATH=D:/ai_models/bge-m3
# HuggingFace 模型名（BGE_M3_PATH 为空时的兜底）
BGE_M3=BAAI/bge-m3
# 运行设备：cpu 或 cuda:0（有 GPU 用 cuda 更快）
BGE_DEVICE=cpu
# 半精度开关：GPU 建议 1，CPU 必须 0
BGE_FP16=0
# 商品名识别调试开关：1=开启诊断日志，0=关闭
ITEM_NAME_DIAG=1

# ---------------- Milvus 向量数据库 ----------------
# Milvus 服务地址（默认端口 19530）
MILVUS_URL=http://localhost:19530
# 切片集合（node_bge_embedding 后续入库使用，可先保留）
CHUNKS_COLLECTION=kb_chunks
# 商品主体（item_name）集合，当前节点实际使用
ITEM_NAME_COLLECTION=kb_item_names
# 稠密向量维度（BGE-M3 默认 1024，勿随意修改）
EMBEDDING_DIM=1024

# ---------------- MinIO 对象存储 ----------------
# 注意：只填 IP:端口，不要带 http://；端口用 S3 API 的 9000，不是控制台 9001
MINIO_ENDPOINT=localhost:9000
# 访问密钥（docker 启动 MinIO 时设置的 MINIO_ROOT_USER）
MINIO_ACCESS_KEY=你的AccessKey
# 密钥（docker 启动 MinIO 时设置的 MINIO_ROOT_PASSWORD）
MINIO_SECRET_KEY=你的SecretKey
# 图片桶名（首次上传会自动创建并设置公开读策略）
MINIO_BUCKET_NAME=knowledge-base-bucket
# 桶内图片目录前缀
MINIO_IMG_DIR=upload-images
# 是否启用 HTTPS：False=http，True=https
MINIO_SECURE=False

# ---------------- MinerU 在线解析 API ----------------
# MinerU API Token（https://mineru.net 控制台获取）
MINERU_API_TOKEN=你的MinerU_TOKEN
# MinerU API 地址（v4 版本）
MINERU_BASE_URL=https://mineru.net/api/v4

# ---------------- 重排序模型（检索模块预留） ----------------
# 本地 reranker 模型路径
BGE_RERANKER_LARGE=D:/ai_models/bge-reranker-large
# 设备：cpu / cuda:0
BGE_RERANKER_DEVICE=cpu
# 半精度：GPU 建议 1
BGE_RERANKER_FP16=0

# ---------------- MCP WebSearch（检索模块预留） ----------------
# 阿里云百炼 WebSearch MCP 地址
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/sse

# ---------------- Neo4j 知识图谱（预留） ----------------
# 如果暂时不启动 Neo4j，以下四项可留空
NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=你的Neo4j密码

# ---------------- MongoDB（历史记录预留） ----------------
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=kb002

# ---------------- 日志配置 ----------------
# 控制台日志开关与级别（DEBUG/INFO/WARNING/ERROR/CRITICAL）
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
# 文件日志开关与级别（可独立于控制台设置）
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
# 日志保留天数，过期自动清理
LOG_FILE_RETENTION=7 days